{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "personal": {
      "type": "object",
      "properties": {
        "firstName": { "type": "string" },
        "middleName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "phoneCountryCode": { "type": "string" },
        "dateOfBirth": { "type": "string" },
        "gender": { "type": "string" },
        "address": {
          "type": "object",
          "properties": {
            "line1": { "type": "string" },
            "line2": { "type": "string" },
            "city": { "type": "string" },
            "state": { "type": "string" },
            "postalCode": { "type": "string" },
            "country": { "type": "string" }
          }
        },
        "links": {
          "type": "object",
          "properties": {
            "linkedin": { "type": "string" },
            "portfolio": { "type": "string" },
            "github": { "type": "string" }
          }
        },
        "currentCtc": { "type": "string" },
        "expectedCtc": { "type": "string" },
        "noticePeriod": { "type": "string" },
        "totalExperienceYears": { "type": "string" },
        "totalExperienceMonths": { "type": "string" },
        "currentLocation": { "type": "string" },
        "preferredLocation": { "type": "string" },
        "salaryCurrency": { "type": "string" }
      },
      "required": ["firstName", "lastName", "email", "phone"]
    },
    "education": {
      "type": "object"
    },
    "workExperience": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "companyName": { "type": "string" },
          "jobTitle": { "type": "string" },
          "startDate": { "type": "string" },
          "endDate": { "type": "string" },
          "currentlyWorking": { "type": "boolean" },
          "description": { "type": "string" },
          "employmentType": { "type": "string" }
        },
        "required": ["companyName", "jobTitle", "startDate", "currentlyWorking"]
      }
    },
    "skills": {
      "type": "array",
      "items": { "type": "string" }
    },
    "documents": {
      "type": "object",
      "properties": {
        "resumeFileName": { "type": "string" },
        "coverLetterFileName": { "type": "string" }
      }
    }
  },
  "required": ["personal", "education", "workExperience", "skills", "documents"]
}
